---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contact — TradingView Optimizer"
  description="Get in touch with the TradingView Optimizer team. Reach us for general enquiries, technical support, or legal matters."
>
  <section class="contact-hero">
    <div class="container contact-container">
      <p class="section-label">Contact</p>
      <h1 class="contact-title">Get in touch</h1>
      <p class="contact-subtitle">
        Pick the right inbox and we'll get back to you as fast as we can.
      </p>

      <div class="contact-cards">

        <a href="mailto:support@tradingviewoptimizer.com" class="contact-card">
          <div class="contact-card-icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="10" cy="10" r="8.5" stroke="currentColor" stroke-width="1.5"/>
              <path d="M10 9v5M10 6.5v.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="contact-card-body">
            <div class="contact-card-label">Support</div>
            <div class="contact-card-desc">
              Installation issues, licence activation, crashes, bugs, or anything
              that's blocking you from using the app.
            </div>
            <div class="contact-card-email">support@tradingviewoptimizer.com</div>
          </div>
          <svg class="contact-card-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <a href="mailto:contact@tradingviewoptimizer.com" class="contact-card">
          <div class="contact-card-icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <rect x="2.5" y="4.5" width="15" height="11" rx="2" stroke="currentColor" stroke-width="1.5"/>
              <path d="M2.5 7.5l7.5 5 7.5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="contact-card-body">
            <div class="contact-card-label">General</div>
            <div class="contact-card-desc">
              Sales, partnerships, press enquiries, feature requests, or anything
              else that doesn't fit the other categories.
            </div>
            <div class="contact-card-email">contact@tradingviewoptimizer.com</div>
          </div>
          <svg class="contact-card-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <a href="mailto:legal@tradingviewoptimizer.com" class="contact-card">
          <div class="contact-card-icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M10 2.5L3 6v4c0 3.87 3 7.5 7 8.5 4-1 7-4.63 7-8.5V6L10 2.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="contact-card-body">
            <div class="contact-card-label">Legal</div>
            <div class="contact-card-desc">
              DMCA notices, GDPR data requests, privacy concerns, or questions
              about our terms of service and policies.
            </div>
            <div class="contact-card-email">legal@tradingviewoptimizer.com</div>
          </div>
          <svg class="contact-card-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

      </div>
    </div>
  </section>
</Base>

<style>
  .contact-hero {
    position: relative;
    z-index: 1;
    padding: 96px 24px 120px;
  }

  .contact-container {
    max-width: 760px;
  }

  .contact-title {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--text-primary);
    margin: 12px 0 16px;
  }

  .contact-subtitle {
    font-size: 16px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 48px;
  }

  .contact-cards {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .contact-card {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    padding: 24px;
    background: var(--bg-cards);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s, transform 0.15s;
    cursor: pointer;
  }

  .contact-card:hover {
    background: var(--bg-elevated);
    border-color: rgba(255,255,255,0.1);
    transform: translateY(-1px);
  }

  .contact-card:hover .contact-card-arrow {
    color: var(--accent);
    transform: translateX(3px);
  }

  .contact-card-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-panels);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--accent);
    margin-top: 2px;
  }

  .contact-card-body {
    flex: 1;
    min-width: 0;
  }

  .contact-card-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 6px;
  }

  .contact-card-desc {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 10px;
  }

  .contact-card-email {
    font-size: 12px;
    font-family: 'Noto Sans Mono', monospace;
    color: var(--accent);
    word-break: break-all;
  }

  .contact-card-arrow {
    flex-shrink: 0;
    color: var(--text-muted);
    margin-top: 10px;
    transition: color 0.15s, transform 0.15s;
  }

  @media (max-width: 600px) {
    .contact-hero { padding: 64px 16px 72px; }
    .contact-card { padding: 18px 16px; gap: 14px; }
    .contact-card-arrow { display: none; }
  }
</style>
